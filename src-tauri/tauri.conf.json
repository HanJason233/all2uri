{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "all2uri",
  "version": "0.1.0",
  "identifier": "com.all2uri.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "all2uri",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/geoip.dat",
      "resources/GEOIP-NOTICE.txt",
      "resources/GEOIP-LICENSE.txt"
    ],
    "shortDescription": "all2uri",
    "longDescription": "all2uri",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
